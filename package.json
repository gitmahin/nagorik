{
  "name": "start-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check:lint": "turbo run check:lint",
    "fix:lint": "turbo run fix:lint",
    "check:types": "turbo run check:types",
    "gen:docs": "turbo run gen:docs",
    "gen:docs-all": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "clean": "turbo run clean && rm -rf node_modules dist docs .turbo && echo 'Root Cleanup complete!'",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "commitizen": "^4.3.2",
    "commitlint-plugin-tense": "^1.0.10",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "globals": "^17.11.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.12",
    "turbo": "^2.9.18",
    "typedoc": "^0.28.20",
    "typescript": "^6",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@repo/constants": "workspace:*",
    "@repo/zod": "workspace:*",
    "install": "^0.13.0",
    "puppeteer": "^25.12.0",
    "zod": "^4.4.3",
    "uuid": "^14.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "puppeteer",
      "unrs-resolver"
    ]
  }
}
