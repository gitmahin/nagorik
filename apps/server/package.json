{
  "name": "server",
  "version": "26.4.1",
  "description": "",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "build": "tsdown",
    "start": "node ./dist/index.mjs",
    "gen:docs": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "check:lint": "eslint . --cache --cache-location ../../node_modules/.cache/eslint/ --max-warnings 1000",
    "fix:lint": "eslint . --cache --cache-location ../../node_modules/.cache/eslint/ --fix --max-warnings=1000",
    "check:types": "node ../../node_modules/typescript-7/bin/tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --verbose",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx ./src/database/seeds/index.ts",
    "test": "vitest",
    "clean": "rm -rf node_modules dist docs .turbo && echo 'Cleanup complete!'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
