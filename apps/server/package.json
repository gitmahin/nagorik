    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "random-words": "^2.0.1",
