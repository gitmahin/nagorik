    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/request-ip": "^0.0.41",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.4"
  },
  "dependencies": {
    "express": "^5.2.1",
    "@repo/shared": "workspace:*",
